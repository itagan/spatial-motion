{
  "name": "@itagan/spatial-motion",
  "version": "1.15.0",
  "description": "High-performance Three.js spatial card layouts and streaming effects for large-screen experiences.",
  "type": "module",
  "license": "MIT",
  "author": "itagan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itagan/spatial-motion.git"
  },
  "homepage": "https://github.com/itagan/spatial-motion#readme",
  "bugs": {
    "url": "https://github.com/itagan/spatial-motion/issues"
  },
  "keywords": [
    "three.js",
    "webgl",
    "animation",
    "large-screen",
    "data-visualization"
  ],
  "engines": {
    "node": ">=20"
  },
  "sideEffects": false,
  "bin": {
    "spatial-motion-benchmark": "./scripts/compare-benchmarks.mjs"
  },
  "files": [
    "dist",
    "!dist/**/*.d.ts.map",
    "!dist/**/*.js.map",
    "scripts/compare-benchmarks.mjs",
    "scripts/benchmark-presets.json",
    "docs/PUBLIC_API.md",
    "docs/COMPATIBILITY.md",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js",
      "default": "./dist/core/index.js"
    },
    "./layouts": {
      "types": "./dist/layouts/index.d.ts",
      "import": "./dist/layouts/index.js",
      "default": "./dist/layouts/index.js"
    },
    "./layouts/sphere": {
      "types": "./dist/layouts/sphere.d.ts",
      "import": "./dist/layouts/sphere.js",
      "default": "./dist/layouts/sphere.js"
    },
    "./layouts/cylinder": {
      "types": "./dist/layouts/cylinder.d.ts",
      "import": "./dist/layouts/cylinder.js",
      "default": "./dist/layouts/cylinder.js"
    },
    "./layouts/grid": {
      "types": "./dist/layouts/grid.d.ts",
      "import": "./dist/layouts/grid.js",
      "default": "./dist/layouts/grid.js"
    },
    "./layouts/ring": {
      "types": "./dist/layouts/ring.d.ts",
      "import": "./dist/layouts/ring.js",
      "default": "./dist/layouts/ring.js"
    },
    "./layouts/helix": {
      "types": "./dist/layouts/helix.d.ts",
      "import": "./dist/layouts/helix.js",
      "default": "./dist/layouts/helix.js"
    },
    "./layouts/cone": {
      "types": "./dist/layouts/cone.d.ts",
      "import": "./dist/layouts/cone.js",
      "default": "./dist/layouts/cone.js"
    },
    "./layouts/box": {
      "types": "./dist/layouts/box.d.ts",
      "import": "./dist/layouts/box.js",
      "default": "./dist/layouts/box.js"
    },
    "./layouts/scatter": {
      "types": "./dist/layouts/scatter.d.ts",
      "import": "./dist/layouts/scatter.js",
      "default": "./dist/layouts/scatter.js"
    },
    "./effects": {
      "types": "./dist/effects/index.d.ts",
      "import": "./dist/effects/index.js",
      "default": "./dist/effects/index.js"
    },
    "./performance": {
      "types": "./dist/performance/index.d.ts",
      "import": "./dist/performance/index.js",
      "default": "./dist/performance/index.js"
    },
    "./card-template": {
      "types": "./dist/card-template/index.d.ts",
      "import": "./dist/card-template/index.js",
      "default": "./dist/card-template/index.js"
    },
    "./renderers/cards": {
      "types": "./dist/renderers/cards/index.d.ts",
      "import": "./dist/renderers/cards/index.js",
      "default": "./dist/renderers/cards/index.js"
    },
    "./renderers/points": {
      "types": "./dist/renderers/points/index.d.ts",
      "import": "./dist/renderers/points/index.js",
      "default": "./dist/renderers/points/index.js"
    },
    "./dev": {
      "types": "./dist/dev/index.d.ts",
      "import": "./dist/dev/index.js",
      "default": "./dist/dev/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "dev:examples": "vite --config vite.examples.config.ts",
    "benchmark:compare": "npm run build:lib --silent && node scripts/compare-benchmarks.mjs",
    "benchmark:matrix": "node scripts/collect-quality-matrix.mjs",
    "build": "npm run build:lib && npm run build:demo && npm run build:examples",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:demo": "vite build",
    "build:examples": "vite build --config vite.examples.config.ts",
    "prepare": "npm run build:lib",
    "prepack": "npm run build:lib",
    "pack:check": "node scripts/verify-package.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run pack:check",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.examples.json && tsc -p tsconfig.browser.json",
    "test": "vitest run --config vitest.config.ts && node --test scripts/quality-calibration.test.mjs",
    "test:browser": "playwright test",
    "test:watch": "vitest --config vitest.config.ts"
  },
  "peerDependencies": {
    "@types/three": ">=0.178.0 <1.0.0",
    "three": ">=0.178.0 <1.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.1.2",
    "@types/three": "^0.178.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "gsap": "^3.15.0",
    "jsdom": "^29.1.1",
    "terser": "^5.49.0",
    "three": "^0.178.0",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.40",
    "vue-tsc": "^3.1.3"
  }
}
